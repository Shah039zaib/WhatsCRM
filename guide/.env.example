# WhatsCRM — Environment Configuration Template
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file to git.

# Server port
PORT=3010

# MySQL database
DBHOST=localhost
DBPORT=3306
DBUSER=whatscrm
DBPASS=change-this-password
DBNAME=whatscrm

# JWT secret (use a long random string in production)
JWTKEY=change-this-to-a-long-random-secret

# Environment: development | production
NODE_ENV=production

# URLs (update for your domain/VPS)
BACKURI=http://localhost:3010
FRONTENDURI=http://localhost:3010

# Optional
STRIPE_LANG=en
# NODE_TLS_REJECT_UNAUTHORIZED=0
